{% comment %}
  Predictive Search Modal Overlay
{% endcomment %}

<div id="search-modal-backdrop" class="modal-backdrop"></div>

<div id="search-modal" class="search-modal" role="dialog" aria-modal="true" aria-label="Search">
  <div style="padding: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <span class="badge badge-editorial">STUDIO SEARCH</span>
      <button type="button" data-action="close-search" style="color: rgba(51,44,40,0.6); padding: 4px;" aria-label="Close search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" style="position: relative;">
      <input type="hidden" name="type" value="product">
      <input
        type="search"
        name="q"
        placeholder="Search for tops, bags, toys, decor..."
        class="form-input"
        style="padding-left: 44px; padding-right: 16px; font-size: 15px;"
        autocomplete="off"
      >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8C6F5A" stroke-width="2" style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); pointer-events: none;">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </form>

    <div style="margin-top: 20px;">
      <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: #8C6F5A; letter-spacing: 0.08em; margin-bottom: 10px;">Popular Searches</div>
      <div style="display: flex; flex-wrap: wrap; gap: 8px;">
        <a href="/search?type=product&q=Tops" class="badge badge-editorial" style="padding: 6px 12px; font-size: 11px;">Crochet Tops</a>
        <a href="/search?type=product&q=Tote" class="badge badge-editorial" style="padding: 6px 12px; font-size: 11px;">Tote Bags</a>
        <a href="/search?type=product&q=Amigurumi" class="badge badge-editorial" style="padding: 6px 12px; font-size: 11px;">Amigurumi Toys</a>
        <a href="/search?type=product&q=Daisy" class="badge badge-editorial" style="padding: 6px 12px; font-size: 11px;">Daisy Motif</a>
        <a href="/search?type=product&q=Coaster" class="badge badge-editorial" style="padding: 6px 12px; font-size: 11px;">Home Coasters</a>
      </div>
    </div>
  </div>
</div>
