{% comment %}
  Renders quantity selector
{% endcomment %}

<div class="quantity-selector" style="display: inline-flex; align-items: center; border: 1px solid var(--color-beige); border-radius: 999px; background: #FFF; padding: 4px 12px; gap: 12px;">
  <button type="button" class="quantity-btn" onclick="const input = this.nextElementSibling; input.value = Math.max(1, parseInt(input.value||1, 10) - 1); input.dispatchEvent(new Event('change'));" style="font-size: 16px; font-weight: bold; color: var(--color-text); padding: 0 4px;">−</button>
  <input type="number" name="quantity" value="1" min="1" style="width: 32px; text-align: center; border: none; font-weight: 700; font-size: 14px; color: var(--color-text); outline: none; -moz-appearance: textfield;" aria-label="Quantity">
  <button type="button" class="quantity-btn" onclick="const input = this.previousElementSibling; input.value = parseInt(input.value||1, 10) + 1; input.dispatchEvent(new Event('change'));" style="font-size: 16px; font-weight: bold; color: var(--color-text); padding: 0 4px;">+</button>
</div>
