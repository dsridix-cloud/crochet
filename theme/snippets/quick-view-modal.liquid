{% comment %}
  Quick View Product Modal
{% endcomment %}

<div id="quick-view-backdrop" class="modal-backdrop"></div>

<div id="quick-view-modal" class="quick-view-modal" role="dialog" aria-modal="true" aria-label="Quick View">
  <div style="padding: 24px; position: relative;">
    <button type="button" id="close-quick-view-btn" style="position: absolute; top: 16px; right: 16px; color: rgba(51,44,40,0.6); padding: 4px;" aria-label="Close modal">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div id="quick-view-content" style="min-height: 200px; display: flex; align-items: center; justify-content: center;">
      <span style="font-size: 13px; color: #8C6F5A;">Loading artisan details...</span>
    </div>
  </div>
</div>
