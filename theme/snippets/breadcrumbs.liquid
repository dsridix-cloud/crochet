{% comment %}
  Renders breadcrumbs navigation
{% endcomment %}

<nav class="breadcrumbs" aria-label="breadcrumbs" style="padding: 12px 0; font-size: 12px; color: rgba(51,44,40,0.6); display: flex; align-items: center; gap: 8px;">
  <a href="{{ routes.root_url }}" style="color: inherit; text-decoration: none;">Home</a>

  <span>/</span>
  {%- if template.name == 'collection' and collection.handle -%}
    <a href="/collections/all" style="color: inherit; text-decoration: none;">Collections</a>
    <span>/</span>
    <span style="font-weight: 600; color: var(--color-text);">{{ collection.title }}</span>
  {%- elsif template.name == 'product' -%}
    {%- if collection.url -%}
      <a href="{{ collection.url }}" style="color: inherit; text-decoration: none;">{{ collection.title }}</a>
      <span>/</span>
    {%- else -%}
      <a href="/collections/all" style="color: inherit; text-decoration: none;">Shop</a>
      <span>/</span>
    {%- endif -%}
    <span style="font-weight: 600; color: var(--color-text);" class="truncate">{{ product.title }}</span>
  {%- elsif template.name == 'cart' -%}
    <span style="font-weight: 600; color: var(--color-text);">Your Shopping Bag</span>
  {%- else -%}
    <span style="font-weight: 600; color: var(--color-text);">{{ page_title }}</span>
  {%- endif -%}
</nav>
