<section class="newsletter-section" style="padding: 72px 0; background: rgba(231,222,210,0.5); border-top: 1px solid var(--color-beige); text-align: center;">
  <div class="container" style="max-width: 600px;">
    
    <span class="badge badge-editorial" style="margin-bottom: 12px;">
      {{ section.settings.badge | default: 'STUDIO DISPATCHES' }}
    </span>

    <h2 class="heading-serif" style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); margin-bottom: 12px;">
      {{ section.settings.heading | default: 'Join the Maison Circle' }}
    </h2>

    <p style="font-size: 14px; color: rgba(51,44,40,0.8); line-height: 1.6; margin-bottom: 24px;">
      {{ section.settings.text | default: 'Subscribe to receive invitations to private seasonal drops, behind-the-scenes artisan workshop updates, and ₹200 off your first order.' }}
    </p>

    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div style="display: flex; flex-direction: column; gap: 8px;" class="sm:flex-row">
        <input
          type="email"
          name="contact[email]"
          placeholder="Your email address"
          required
          class="form-input"
          style="flex: 1; padding: 12px 18px; font-size: 14px; border-radius: 999px;"
        >
        <button type="submit" class="btn btn-primary" style="padding: 12px 24px; font-size: 12px; border-radius: 999px; white-space: nowrap;">
          <span>{{ section.settings.button_text | default: 'JOIN THE CIRCLE' }}</span>
        </button>
      </div>

      {%- if form.posted_successfully? -%}
        <p style="margin-top: 12px; font-size: 13px; color: var(--color-brown); font-weight: 600;">
          Thank you for subscribing to our artisan studio!
        </p>
      {%- endif -%}
    {% endform %}

  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "STUDIO DISPATCHES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Maison Circle"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Subscribe to receive invitations to private seasonal drops, behind-the-scenes artisan workshop updates, and ₹200 off your first order."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "JOIN THE CIRCLE"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
