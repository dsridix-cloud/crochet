<section class="customer-order-section" style="padding: 48px 0 80px; background: var(--color-bg);">
  <div class="container">
    {% render 'breadcrumbs' %}

    <div style="margin-top: 16px; margin-bottom: 32px;">
      <a href="{{ routes.account_url }}" style="font-size: 12px; color: #8C6F5A; text-decoration: underline;">&larr; Return to Account Overview</a>
      <h1 class="heading-serif" style="font-size: 26px; margin-top: 8px;">Order {{ order.name }}</h1>
      <p style="font-size: 13px; color: rgba(51,44,40,0.7);">Placed on {{ order.created_at | time_tag: format: 'date_at_time' }}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-8">
        <div style="background: #FFF; border-radius: var(--radius-lg); border: 1px solid var(--color-beige); padding: 24px; box-shadow: var(--shadow-subtle);">
          <h2 style="font-family: var(--font-heading); font-size: 16px; font-weight: 700; margin-bottom: 16px;">Order Items</h2>
          <div style="divide-y: 1px solid var(--color-beige);">
            {%- for line_item in order.line_items -%}
              <div style="padding: 14px 0; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-beige);">
                <div>
                  <div style="font-weight: 700; font-size: 14px;">{{ line_item.title }}</div>
                  <div style="font-size: 12px; color: rgba(51,44,40,0.6);">Qty: {{ line_item.quantity }} × {{ line_item.final_price | money }}</div>
                </div>
                <div style="font-weight: 700; font-size: 14px;">{{ line_item.final_line_price | money }}</div>
              </div>
            {%- endfor -%}
          </div>

          <div style="margin-top: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 13px;">
            <div style="display: flex; justify-content: space-between;">
              <span>Subtotal</span>
              <span>{{ order.line_items_subtotal_price | money }}</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Shipping</span>
              <span>{{ order.shipping_price | money }}</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-weight: 700; font-size: 16px; padding-top: 10px; border-top: 1px solid var(--color-beige);">
              <span>Total</span>
              <span>{{ order.total_price | money_with_currency }}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-4">
        <div style="background: #FFF; border-radius: var(--radius-lg); border: 1px solid var(--color-beige); padding: 24px; box-shadow: var(--shadow-subtle); display: flex; flex-direction: column; gap: 16px;">
          <h2 style="font-family: var(--font-heading); font-size: 16px; font-weight: 700;">Shipping Details</h2>
          <div style="font-size: 13px; color: rgba(51,44,40,0.85); line-height: 1.5;">
            {{ order.shipping_address | format_address }}
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Customer Order Detail",
  "settings": []
}
{% endschema %}
