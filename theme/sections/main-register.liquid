<section class="customer-register-section" style="padding: 64px 0 96px; background: var(--color-bg);">
  <div class="container" style="max-width: 500px;">
    
    <div style="background: #FFF; border-radius: var(--radius-xl); border: 1px solid var(--color-beige); padding: 36px 32px; box-shadow: var(--shadow-subtle);">
      
      <!-- Register Header -->
      <div style="text-align: center; margin-bottom: 28px;">
        <span class="badge badge-editorial" style="margin-bottom: 8px;">JOIN THE COLLECTIVE</span>
        <h1 class="heading-serif" style="font-size: 26px;">
          {{ 'customer.register.title' | t }}
        </h1>
        <p style="font-size: 13px; color: rgba(51,44,40,0.7); margin-top: 4px;">
          {{ 'customer.register.subtitle' | t }}
        </p>
      </div>

      <!-- Register Form -->
      {% form 'create_customer' %}
        {{ form.errors | default_errors }}

        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div>
            <label for="RegisterFirstName" style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 6px;">{{ 'customer.register.first_name' | t }}</label>
            <input type="text" name="customer[first_name]" id="RegisterFirstName" class="form-input">
          </div>

          <div>
            <label for="RegisterLastName" style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 6px;">{{ 'customer.register.last_name' | t }}</label>
            <input type="text" name="customer[last_name]" id="RegisterLastName" class="form-input">
          </div>

          <div>
            <label for="RegisterEmail" style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 6px;">{{ 'customer.register.email' | t }} *</label>
            <input type="email" name="customer[email]" id="RegisterEmail" required class="form-input">
          </div>

          <div>
            <label for="RegisterPassword" style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 6px;">{{ 'customer.register.password' | t }} *</label>
            <input type="password" name="customer[password]" id="RegisterPassword" required class="form-input">
          </div>

          <button type="submit" class="btn btn-primary" style="padding: 14px; font-size: 12px; justify-content: center; width: 100%; margin-top: 6px;">
            <span>{{ 'customer.register.submit' | t }}</span>
          </button>
        </div>
      {% endform %}

      <!-- Login Link -->
      <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--color-beige); text-align: center; font-size: 13px; color: rgba(51,44,40,0.75);">
        <a href="{{ routes.account_login_url }}" style="color: var(--color-brown); font-weight: 700; margin-left: 4px;">{{ 'customer.register.already_have_account' | t }}</a>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Customer Register",
  "settings": []
}
{% endschema %}
