<section class="custom-order-banner" style="background-color: var(--color-text); color: var(--color-bg); padding: 80px 0; position: relative; overflow: hidden;">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10" style="align-items: center;">
      
      <div class="lg:col-span-8" style="display: flex; flex-direction: column; gap: 16px;">
        <span class="badge" style="background: rgba(217,167,160,0.2); color: #D9A7A0; border: 1px solid rgba(217,167,160,0.3); align-self: flex-start;">
          {{ section.settings.badge | default: 'BESPOKE ARTISAN SERVICE' }}
        </span>

        <h2 class="heading-serif" style="font-size: clamp(2rem, 4vw, 3rem); color: var(--color-bg); line-height: 1.15;">
          {{ section.settings.heading | default: 'Have a specific idea in mind? Let\'s crochet it together.' }}
        </h2>

        <p style="font-size: 15px; color: rgba(248,244,238,0.8); line-height: 1.6; max-width: 600px; font-weight: 300;">
          {{ section.settings.text | default: 'From custom bridal shrugs and heirloom baby blankets to specific colorways for your home, our studio artisans craft one-of-a-kind bespoke commissions.' }}
        </p>

        <div style="display: flex; flex-wrap: wrap; gap: 20px; font-size: 12px; color: #D9A7A0; padding-top: 8px;">
          <div style="display: flex; align-items: center; gap: 6px;">
            <span>✓</span> Custom Color Palette
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <span>✓</span> Made-to-Measure Sizing
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <span>✓</span> Direct Artisan Consultation
          </div>
        </div>
      </div>

      <div class="lg:col-span-4" style="display: flex; flex-direction: column; align-items: flex-start; justify-content: center;" class="lg:items-end">
        <a href="{{ section.settings.button_link | default: '/pages/custom-orders' }}" class="btn btn-accent" style="padding: 16px 28px; font-size: 12px; width: 100%; text-align: center; justify-content: center;">
          <span>{{ section.settings.button_text | default: 'START BESPOKE ORDER' }}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <span style="font-size: 11px; color: rgba(248,244,238,0.6); margin-top: 10px; display: block; text-align: center; width: 100%;">Average turnaround: 7–14 business days</span>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Order Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "BESPOKE ARTISAN SERVICE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Have a specific idea in mind? Let's crochet it together."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "From custom bridal shrugs and heirloom baby blankets to specific colorways for your home, our studio artisans craft one-of-a-kind bespoke commissions."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "START BESPOKE ORDER"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Order Banner"
    }
  ]
}
{% endschema %}
