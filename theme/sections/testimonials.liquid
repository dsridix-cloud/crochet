<section class="testimonials-section" style="padding: 80px 0; background: var(--color-bg);">
  <div class="container">
    
    <div style="text-align: center; max-width: 600px; margin: 0 auto 48px;">
      <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: var(--color-brown);">
        {{ section.settings.subheading | default: 'Client Stories' }}
      </span>
      <h2 class="heading-serif" style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); margin-top: 4px; margin-bottom: 12px;">
        {{ section.settings.heading | default: 'Loved by Conscious Souls' }}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div style="padding: 32px 24px; border-radius: var(--radius-lg); background: #FFF; border: 1px solid var(--color-beige); box-shadow: var(--shadow-subtle); display: flex; flex-direction: column; justify-content: space-between; gap: 20px;">
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div style="display: flex; gap: 3px; color: #D9A7A0;">
            ★★★★★
          </div>
          <p style="font-family: var(--font-editorial); font-style: italic; font-size: 15px; color: rgba(51,44,40,0.85); line-height: 1.5;">
            "The crochet halter top is pure poetry. The yarn is so breathable and soft against the skin, and the stitches are flawlessly tight. I received compliments all day long."
          </p>
        </div>
        <div style="display: flex; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px solid var(--color-beige);">
          <div style="width: 36px; height: 36px; border-radius: 50%; background: #D9A7A0; color: #FFF; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px;">
            A
          </div>
          <div>
            <div style="font-weight: 700; font-size: 13px; color: var(--color-text);">Aanya Sharma</div>
            <div style="font-size: 11px; color: #8C6F5A;">Mumbai • Verified Buyer</div>
          </div>
        </div>
      </div>

      <div style="padding: 32px 24px; border-radius: var(--radius-lg); background: #FFF; border: 1px solid var(--color-beige); box-shadow: var(--shadow-subtle); display: flex; flex-direction: column; justify-content: space-between; gap: 20px;">
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div style="display: flex; gap: 3px; color: #D9A7A0;">
            ★★★★★
          </div>
          <p style="font-family: var(--font-editorial); font-style: italic; font-size: 15px; color: rgba(51,44,40,0.85); line-height: 1.5;">
            "I ordered the Daisy Tote Bag and it has become my everyday companion. It holds my laptop, water bottle and diary with zero sagging. Knowing who made it makes it so special."
          </p>
        </div>
        <div style="display: flex; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px solid var(--color-beige);">
          <div style="width: 36px; height: 36px; border-radius: 50%; background: #AAB5A0; color: #FFF; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px;">
            R
          </div>
          <div>
            <div style="font-weight: 700; font-size: 13px; color: var(--color-text);">Rhea Mukherjee</div>
            <div style="font-size: 11px; color: #8C6F5A;">Bengaluru • Verified Buyer</div>
          </div>
        </div>
      </div>

      <div style="padding: 32px 24px; border-radius: var(--radius-lg); background: #FFF; border: 1px solid var(--color-beige); box-shadow: var(--shadow-subtle); display: flex; flex-direction: column; justify-content: space-between; gap: 20px;">
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div style="display: flex; gap: 3px; color: #D9A7A0;">
            ★★★★★
          </div>
          <p style="font-family: var(--font-editorial); font-style: italic; font-size: 15px; color: rgba(51,44,40,0.85); line-height: 1.5;">
            "Ordered a bespoke custom amigurumi bunny with personalized initials for my niece's first birthday. The studio communicated every step and delivered pure perfection."
          </p>
        </div>
        <div style="display: flex; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px solid var(--color-beige);">
          <div style="width: 36px; height: 36px; border-radius: 50%; background: #8C6F5A; color: #FFF; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px;">
            P
          </div>
          <div>
            <div style="font-weight: 700; font-size: 13px; color: var(--color-text);">Pooja Verma</div>
            <div style="font-size: 11px; color: #8C6F5A;">New Delhi • Custom Client</div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Client Stories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Conscious Souls"
    }
  ],
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}
