<section class="collection-list-section" style="padding: 72px 0; background: var(--color-bg);">
  <div class="container">
    
    <div style="text-align: center; max-width: 600px; margin: 0 auto 48px;">
      <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: var(--color-brown);">
        {{ section.settings.subheading | default: 'Mindfully Crafted' }}
      </span>
      <h2 class="heading-serif" style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); margin-top: 4px; margin-bottom: 12px;">
        {{ section.settings.heading | default: 'Shop by Category' }}
      </h2>
      <p style="font-size: 14px; color: rgba(51,44,40,0.7);">
        {{ section.settings.description | default: 'Each collection is designed for conscious living, pairing timeless crochet motifs with contemporary silhouettes.' }}
      </p>
    </div>

    <!-- Category Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign collection = block.settings.collection -%}
          <div class="category-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.title | default: collection.title | escape }}"
                loading="lazy"
                class="category-card__image"
              >
            {%- elsif collection.featured_image != blank -%}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                class="category-card__image"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'category-card__image placeholder-svg' }}
            {%- endif -%}

            <div class="category-card__overlay">
              <span style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: #E7DED2; font-weight: 600; margin-bottom: 2px;">
                {{ block.settings.subtitle | default: 'Soft, stylish & handmade' }}
              </span>
              <h3 style="font-family: var(--font-heading); font-size: 18px; font-weight: 700; color: #FFF;">
                {{ block.settings.title | default: collection.title | default: 'Crochet Collection' }}
              </h3>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.2); font-size: 12px; color: rgba(255,255,255,0.85);">
                <span>{{ collection.all_products_count | default: 6 }} styles</span>
                <a href="{{ collection.url | default: '/collections/all' }}" style="display: flex; align-items: center; gap: 4px; font-weight: 600; color: #FFF;">
                  <span>Explore</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#D9A7A0" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for collection in collections limit: 5 -%}
          <div class="category-card">
            {%- if collection.featured_image != blank -%}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                class="category-card__image"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'category-card__image placeholder-svg' }}
            {%- endif -%}

            <div class="category-card__overlay">
              <span style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: #E7DED2; font-weight: 600; margin-bottom: 2px;">
                Handmade Edition
              </span>
              <h3 style="font-family: var(--font-heading); font-size: 18px; font-weight: 700; color: #FFF;">
                {{ collection.title }}
              </h3>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.2); font-size: 12px; color: rgba(255,255,255,0.85);">
                <span>{{ collection.all_products_count }} pieces</span>
                <a href="{{ collection.url }}" style="display: flex; align-items: center; gap: 4px; font-weight: 600; color: #FFF;">
                  <span>Explore</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#D9A7A0" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Collection List",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Mindfully Crafted"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Each collection is designed for conscious living, pairing timeless crochet motifs with contemporary silhouettes."
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Everyday pieces with personality"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection List",
      "blocks": [
        { "type": "featured_collection", "settings": { "title": "Crochet Tops", "subtitle": "Soft, stylish & handmade" } },
        { "type": "featured_collection", "settings": { "title": "Crochet Bags", "subtitle": "Everyday pieces with personality" } },
        { "type": "featured_collection", "settings": { "title": "Crochet Toys", "subtitle": "Handmade little friends" } },
        { "type": "featured_collection", "settings": { "title": "Home & Decor", "subtitle": "Small details for beautiful spaces" } },
        { "type": "featured_collection", "settings": { "title": "Handmade Gifts", "subtitle": "Thoughtful handmade gifting" } }
      ]
    }
  ]
}
{% endschema %}
