<section class="why-choose-us-section" style="padding: 72px 0; background: #FFF; border-top: 1px solid var(--color-beige); border-bottom: 1px solid var(--color-beige);">
  <div class="container">
    
    <div style="text-align: center; max-width: 600px; margin: 0 auto 48px;">
      <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: var(--color-brown);">
        {{ section.settings.subheading | default: 'Our Core Promise' }}
      </span>
      <h2 class="heading-serif" style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); margin-top: 4px; margin-bottom: 12px;">
        {{ section.settings.heading | default: 'Why Choose Maison Crochet' }}
      </h2>
      <p style="font-size: 14px; color: rgba(51,44,40,0.7);">
        {{ section.settings.description | default: 'We focus on craftsmanship over mass production, bringing thoughtful artisanal quality to your everyday wardrobe.' }}
      </p>
    </div>

    <!-- 4 Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <div style="padding: 24px; border-radius: var(--radius-lg); background: var(--color-bg); border: 1px solid var(--color-beige); display: flex; flex-direction: column; gap: 12px;">
        <div style="width: 44px; height: 44px; border-radius: 50%; background: #FFF; display: flex; align-items: center; justify-content: center; color: #8C6F5A; box-shadow: var(--shadow-subtle);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
        </div>
        <h3 style="font-family: var(--font-heading); font-size: 16px; font-weight: 700; color: var(--color-text);">100% Handcrafted</h3>
        <p style="font-size: 13px; color: rgba(51,44,40,0.75); line-height: 1.5;">Every single item is made loop-by-loop by talented craftswomen with patience and care.</p>
      </div>

      <div style="padding: 24px; border-radius: var(--radius-lg); background: var(--color-bg); border: 1px solid var(--color-beige); display: flex; flex-direction: column; gap: 12px;">
        <div style="width: 44px; height: 44px; border-radius: 50%; background: #FFF; display: flex; align-items: center; justify-content: center; color: #8C6F5A; box-shadow: var(--shadow-subtle);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 style="font-family: var(--font-heading); font-size: 16px; font-weight: 700; color: var(--color-text);">Pure Natural Yarns</h3>
        <p style="font-size: 13px; color: rgba(51,44,40,0.75); line-height: 1.5;">We use premium organic cotton, bamboo, and soft milk cotton yarns for zero skin irritation.</p>
      </div>

      <div style="padding: 24px; border-radius: var(--radius-lg); background: var(--color-bg); border: 1px solid var(--color-beige); display: flex; flex-direction: column; gap: 12px;">
        <div style="width: 44px; height: 44px; border-radius: 50%; background: #FFF; display: flex; align-items: center; justify-content: center; color: #8C6F5A; box-shadow: var(--shadow-subtle);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
        </div>
        <h3 style="font-family: var(--font-heading); font-size: 16px; font-weight: 700; color: var(--color-text);">Bespoke Custom Orders</h3>
        <p style="font-size: 13px; color: rgba(51,44,40,0.75); line-height: 1.5;">Choose your preferred yarn colors, dimensions, and personalized details directly with our studio.</p>
      </div>

      <div style="padding: 24px; border-radius: var(--radius-lg); background: var(--color-bg); border: 1px solid var(--color-beige); display: flex; flex-direction: column; gap: 12px;">
        <div style="width: 44px; height: 44px; border-radius: 50%; background: #FFF; display: flex; align-items: center; justify-content: center; color: #8C6F5A; box-shadow: var(--shadow-subtle);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        </div>
        <h3 style="font-family: var(--font-heading); font-size: 16px; font-weight: 700; color: var(--color-text);">Fair Trade Impact</h3>
        <p style="font-size: 13px; color: rgba(51,44,40,0.75); line-height: 1.5;">Direct fair wages, flexible home-based working conditions, and financial independence for artisans.</p>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Why Choose Us",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Core Promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Maison Crochet"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We focus on craftsmanship over mass production, bringing thoughtful artisanal quality to your everyday wardrobe."
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us"
    }
  ]
}
{% endschema %}
