<section class="main-page-section" style="padding: 48px 0 80px; background: var(--color-bg);">
  <div class="container" style="max-width: 840px;">
    {% render 'breadcrumbs' %}

    <div style="margin-top: 16px; margin-bottom: 32px;">
      <h1 class="heading-serif" style="font-size: clamp(2rem, 4vw, 2.8rem);">
        {{ page.title }}
      </h1>
    </div>

    <div class="rte" style="background: #FFF; border-radius: var(--radius-lg); border: 1px solid var(--color-beige); padding: 32px; box-shadow: var(--shadow-subtle); font-size: 15px; line-height: 1.7; color: rgba(51,44,40,0.85);">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Default Page",
  "settings": []
}
{% endschema %}
