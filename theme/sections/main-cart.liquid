<section class="main-cart-section" style="padding: 48px 0 80px; background: var(--color-bg);">
  <div class="container">
    
    {% render 'breadcrumbs' %}

    <div style="margin-top: 16px; margin-bottom: 32px;">
      <h1 class="heading-serif" style="font-size: clamp(2rem, 4vw, 2.8rem);">
        {{ 'cart.title' | t }}
      </h1>
      <p style="font-size: 14px; color: rgba(51,44,40,0.7); margin-top: 4px;">
        Review your handcrafted selections before checking out.
      </p>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
          
          <!-- Cart Items Left (Col 8) -->
          <div class="lg:col-span-8">
            <div style="background: #FFF; border-radius: var(--radius-lg); border: 1px solid var(--color-beige); overflow: hidden; box-shadow: var(--shadow-subtle);">
              
              <!-- Free Shipping Bar inside Cart Page -->
              <div style="background: rgba(231,222,210,0.4); padding: 14px 20px; border-bottom: 1px solid var(--color-beige);">
                <div style="font-size: 12px; font-weight: 600; color: var(--color-text); margin-bottom: 6px;">
                  {%- assign threshold = 99900 -%}
                  {%- if cart.total_price >= threshold -%}
                    🎉 {{ 'cart.free_shipping_unlocked' | t }}
                  {%- else -%}
                    {%- assign diff = threshold | minus: cart.total_price | money -%}
                    {{ 'cart.free_shipping_needed' | t: amount: diff }}
                  {%- endif -%}
                </div>
                <div style="width: 100%; height: 6px; background: var(--color-beige); border-radius: 999px; overflow: hidden;">
                  {%- assign pct = cart.total_price | times: 100 | divided_by: threshold -%}
                  {%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}
                  <div style="width: {{ pct }}%; height: 100%; background: var(--color-brown); border-radius: 999px; transition: width 0.3s ease;"></div>
                </div>
              </div>

              <!-- Line Items -->
              <div style="divide-y: 1px solid var(--color-beige);">
                {%- for item in cart.items -%}
                  <div style="padding: 20px; display: flex; gap: 16px; align-items: center; border-bottom: 1px solid var(--color-beige);">
                    <div style="width: 80px; height: 80px; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--color-beige); background: #FFF; flex-shrink: 0;">
                      <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>

                    <div style="flex: 1; min-width: 0;">
                      <a href="{{ item.url }}" style="font-family: var(--font-heading); font-size: 15px; font-weight: 700; color: var(--color-text); text-decoration: none; display: block;">
                        {{ item.product.title }}
                      </a>
                      {%- unless item.product.has_only_default_variant -%}
                        <div style="font-size: 12px; color: #8C6F5A; margin-top: 2px;">
                          {{ item.variant.title }}
                        </div>
                      {%- endunless -%}
                      <div style="font-size: 13px; font-weight: 700; color: var(--color-text); margin-top: 4px;">
                        {{ item.final_price | money }}
                      </div>
                    </div>

                    <!-- Quantity Control -->
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <div class="quantity-selector" style="display: inline-flex; align-items: center; border: 1px solid var(--color-beige); border-radius: 999px; padding: 2px 10px; gap: 8px;">
                        <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" style="font-size: 14px; font-weight: bold; color: var(--color-text); text-decoration: none;">−</a>
                        <span style="font-size: 13px; font-weight: 700;">{{ item.quantity }}</span>
                        <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" style="font-size: 14px; font-weight: bold; color: var(--color-text); text-decoration: none;">+</a>
                      </div>

                      <a href="/cart/change?line={{ forloop.index }}&quantity=0" style="color: rgba(51,44,40,0.4); padding: 6px;" title="{{ 'cart.remove' | t }}">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      </a>
                    </div>
                  </div>
                {%- endfor -%}
              </div>

              <!-- Cart Actions -->
              <div style="padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; background: rgba(248,244,238,0.5);">
                <button type="submit" name="update" class="btn btn-secondary" style="padding: 8px 16px; font-size: 11px;">
                  Update Bag
                </button>
              </div>

            </div>
          </div>

          <!-- Summary Right (Col 4) -->
          <div class="lg:col-span-4">
            <div style="background: #FFF; border-radius: var(--radius-lg); border: 1px solid var(--color-beige); padding: 24px; box-shadow: var(--shadow-subtle); display: flex; flex-direction: column; gap: 16px;">
              <h2 style="font-family: var(--font-heading); font-size: 18px; font-weight: 700; color: var(--color-text); padding-bottom: 12px; border-bottom: 1px solid var(--color-beige);">
                Order Summary
              </h2>

              <div style="display: flex; justify-content: space-between; font-size: 13px; color: rgba(51,44,40,0.8);">
                <span>{{ 'cart.subtotal' | t }}</span>
                <span style="font-weight: 700; color: var(--color-text);">{{ cart.total_price | money }}</span>
              </div>

              <div style="display: flex; justify-content: space-between; font-size: 13px; color: rgba(51,44,40,0.8);">
                <span>Shipping</span>
                <span>{% if cart.total_price >= threshold %}FREE{% else %}{{ 'cart.shipping_at_checkout' | t }}{% endif %}</span>
              </div>

              <div style="padding-top: 14px; border-top: 1px solid var(--color-beige); display: flex; justify-content: space-between; align-items: baseline;">
                <span style="font-size: 15px; font-weight: 700; color: var(--color-text);">Total</span>
                <span style="font-size: 20px; font-weight: 700; color: var(--color-text);">{{ cart.total_price | money }}</span>
              </div>

              <button type="submit" name="checkout" class="btn btn-primary" style="width: 100%; padding: 14px; font-size: 12px; justify-content: center; margin-top: 8px;">
                <span>{{ 'cart.checkout' | t }}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </button>

              <div style="font-size: 11px; color: rgba(51,44,40,0.6); text-align: center; line-height: 1.5;">
                🔒 Safe & secure SSL checkout. 100% plastic-free packaging.
              </div>
            </div>
          </div>

        </div>
      </form>
    {%- else -%}
      <div style="text-align: center; padding: 80px 20px; background: #FFF; border-radius: var(--radius-xl); border: 1px solid var(--color-beige); max-width: 600px; margin: 0 auto;">
        <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--color-bg); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; color: #8C6F5A;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </div>
        <h2 class="heading-serif" style="font-size: 24px; margin-bottom: 8px;">{{ 'cart.empty' | t }}</h2>
        <p style="font-size: 14px; color: rgba(51,44,40,0.7); margin-bottom: 24px;">{{ 'cart.empty_subtext' | t }}</p>
        <a href="/collections/all" class="btn btn-primary">
          {{ 'cart.explore_btn' | t }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
