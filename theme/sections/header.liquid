<header id="main-header" style="position: sticky; top: 0; z-index: 40; width: 100%; background: var(--color-bg); border-bottom: 1px solid var(--color-beige); transition: all 0.3s ease;">
  <div class="container" style="padding-top: 12px; padding-bottom: 12px;">
    
    <!-- Top Action Bar -->
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px;">
      
      <!-- Left: Mobile Menu Toggle / Studio Stamp -->
      <div style="display: flex; align-items: center; gap: 12px; min-width: 0;">
        <button
          type="button"
          id="mobile-menu-toggle"
          style="display: flex; align-items: center; gap: 6px; padding: 6px 10px; border-radius: var(--radius-sm); color: var(--color-text);"
          aria-label="{{ 'header.menu' | t }}"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;" class="hidden sm:inline">{{ 'header.menu' | t }}</span>
        </button>

        <div style="display: none; align-items: center; gap: 6px; font-size: 12px; color: rgba(51,44,40,0.7); font-weight: 500;" class="lg:flex">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#D9A7A0" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
          <span>{{ 'header.studio_tag' | t }}</span>
        </div>
      </div>

      <!-- Center: Logo -->
      <div style="text-align: center;">
        <a href="{{ routes.root_url }}" style="display: inline-block; text-decoration: none;">
          {%- if section.settings.logo != blank -%}
            <img
              src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
              alt="{{ shop.name | escape }}"
              style="max-width: {{ section.settings.logo_width }}px; height: auto;"
            >
          {%- else -%}
            <span style="font-family: var(--font-heading); font-size: 24px; font-weight: 700; letter-spacing: 0.15em; color: var(--color-text); text-transform: uppercase; display: block; line-height: 1.1;">
              {{ shop.name | default: 'MAISON CROCHET' }}
            </span>
            <span style="font-size: 9px; text-transform: uppercase; letter-spacing: 0.25em; font-weight: 600; color: #8C6F5A; display: block; margin-top: 1px;">
              {{ 'header.studio_tag' | t }}
            </span>
          {%- endif -%}
        </a>
      </div>

      <!-- Right: Action Icons (Search, Wishlist, Account, Cart) -->
      <div style="display: flex; align-items: center; gap: 8px;">
        <!-- Search Trigger -->
        <button
          type="button"
          data-action="open-search"
          style="padding: 8px; border-radius: 50%; color: var(--color-text); display: flex; align-items: center; justify-content: center;"
          aria-label="{{ 'header.search' | t }}"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>

        <!-- Account Link -->
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          style="padding: 8px; border-radius: 50%; color: var(--color-text); display: flex; align-items: center; justify-content: center;"
          aria-label="{{ 'header.account' | t }}"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>

        <!-- Wishlist -->
        <a
          href="/pages/wishlist"
          style="padding: 8px; border-radius: 50%; color: var(--color-text); position: relative; display: flex; align-items: center; justify-content: center;"
          aria-label="{{ 'header.wishlist' | t }}"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span class="wishlist-count-badge" style="position: absolute; top: 2px; right: 2px; background: #D9A7A0; color: #FFF; font-size: 10px; font-weight: 700; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">0</span>
        </a>

        <!-- Cart Button -->
        <a
          href="{{ routes.cart_url }}"
          data-action="open-cart-drawer"
          style="padding: 8px 12px; background: var(--color-text); color: var(--color-bg); border-radius: 999px; font-size: 12px; font-weight: 700; display: flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(51,44,40,0.15);"
          aria-label="{{ 'header.cart' | t }}"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D9A7A0" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="cart-count-badge">{{ cart.item_count }}</span>
        </a>
      </div>

    </div>

    <!-- Desktop Navigation Bar -->
    {%- if section.settings.menu != blank -%}
      <nav class="desktop-navigation" style="display: none; justify-content: center; align-items: center; gap: 28px; margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(231,222,210,0.6);" class="lg:flex">
        {%- for link in linklists[section.settings.menu].links -%}
          <div style="position: relative;" class="nav-item">
            <a
              href="{{ link.url }}"
              style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text); padding: 6px 0; display: flex; align-items: center; gap: 4px;"
            >
              <span>{{ link.title }}</span>
              {%- if link.links.size > 0 -%}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              {%- endif -%}
            </a>

            {%- if link.links.size > 0 -%}
              <div class="nav-dropdown" style="position: absolute; top: 100%; left: 0; background: #FFF; border: 1px solid var(--color-beige); border-radius: var(--radius-md); box-shadow: var(--shadow-hover); padding: 12px 0; min-width: 200px; z-index: 50; display: none;">
                {%- for childlink in link.links -%}
                  <a
                    href="{{ childlink.url }}"
                    style="display: block; padding: 8px 20px; font-size: 13px; color: var(--color-text); font-weight: 500;"
                    onmouseover="this.style.backgroundColor='#F8F4EE'; this.style.color='#8C6F5A';"
                    onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--color-text)';"
                  >
                    {{ childlink.title }}
                  </a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </nav>
    {%- endif -%}

  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="mobile-nav-backdrop" class="drawer-backdrop"></div>
<div id="mobile-nav-drawer" class="mobile-drawer" style="position: fixed; top: 0; left: 0; bottom: 0; width: 85%; max-width: 340px; background: var(--color-bg); z-index: 999; transform: translateX(-100%); transition: transform 0.35s ease; padding: 24px; overflow-y: auto; box-shadow: 4px 0 20px rgba(0,0,0,0.1);">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--color-beige);">
    <span style="font-family: var(--font-heading); font-size: 18px; font-weight: 700;">{{ 'header.menu' | t }}</span>
    <button type="button" onclick="document.getElementById('mobile-nav-drawer').classList.remove('is-open'); document.getElementById('mobile-nav-backdrop').classList.remove('is-active');" style="padding: 4px;" aria-label="{{ 'header.close' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div style="display: flex; flex-direction: column; gap: 14px;">
    {%- for link in linklists[section.settings.menu].links -%}
      <div>
        <a href="{{ link.url }}" style="font-size: 15px; font-weight: 700; color: var(--color-text); text-transform: uppercase; letter-spacing: 0.05em; display: block; padding: 4px 0;">
          {{ link.title }}
        </a>
        {%- if link.links.size > 0 -%}
          <div style="padding-left: 12px; margin-top: 6px; display: flex; flex-direction: column; gap: 8px;">
            {%- for childlink in link.links -%}
              <a href="{{ childlink.url }}" style="font-size: 13px; color: #8C6F5A;">
                {{ childlink.title }}
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <!-- Mobile Language Selector -->
  {%- if localization.available_languages.size > 1 -%}
    <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--color-beige);">
      {% form 'localization' %}
        <div style="position: relative; display: inline-flex; align-items: center; background: #FFF; border: 1px solid var(--color-beige); border-radius: var(--radius-md); padding: 8px 12px; width: 100%;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 10px; color: #8C6F5A;"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <select name="locale_code" onchange="this.form.submit()" style="background: transparent; border: none; font-size: 13px; color: var(--color-text); outline: none; cursor: pointer; text-transform: uppercase; font-weight: 700; width: 100%;">
            {% for locale in localization.available_languages %}
              <option
                value="{{ locale.iso_code }}"
                {% if locale.iso_code == localization.language.iso_code %}selected{% endif %}
              >
                {{ locale.endonym_name }}
              </option>
            {% endfor %}
          </select>
        </div>
      {% endform %}
    </div>
  {%- endif -%}

  <div style="margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--color-beige); font-size: 12px; color: rgba(51,44,40,0.7); space-y: 8px;">
    <div>{{ 'header.studio_tag' | t }}</div>
    <div style="color: #8C6F5A; font-weight: 600; margin-top: 4px;">hello@maisoncrochet.in</div>
  </div>
</div>

<style>
  @media (min-width: 1024px) {
    .desktop-navigation { display: flex !important; }
    #mobile-menu-toggle { display: none !important; }
  }
  .nav-item:hover .nav-dropdown { display: block !important; }
  .mobile-drawer.is-open { transform: translateX(0) !important; }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo Width",
      "default": 180
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
