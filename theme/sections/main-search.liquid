{%- paginate search.results by 12 -%}
<section class="main-search-section" style="padding: 48px 0 80px; background: var(--color-bg);">
  <div class="container">
    
    {% render 'breadcrumbs' %}

    <div style="max-width: 600px; margin: 16px auto 40px; text-align: center;">
      <span class="badge badge-editorial" style="margin-bottom: 8px;">STUDIO SEARCH</span>
      <h1 class="heading-serif" style="font-size: clamp(2rem, 4vw, 2.8rem);">
        {%- if search.performed -%}
          Search results for "{{ search.terms | escape }}"
        {%- else -%}
          Search Handcrafted Pieces
        {%- endif -%}
      </h1>

      <form action="{{ routes.search_url }}" method="get" role="search" style="margin-top: 20px; position: relative;">
        <input type="hidden" name="type" value="product">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search for tops, bags, toys, decor..."
          class="form-input"
          style="padding: 12px 18px 12px 44px; font-size: 15px; border-radius: 999px;"
        >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8C6F5A" stroke-width="2" style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); pointer-events: none;">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </form>
    </div>

    {%- if search.performed -%}
      <div style="font-size: 13px; color: rgba(51,44,40,0.7); margin-bottom: 24px; padding-bottom: 12px; border-bottom: 1px solid var(--color-beige);">
        Found <strong>{{ search.results_count }}</strong> items matching your query
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product_card_product: item %}
          {%- endif -%}
        {%- else -%}
          <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px;">
            <p style="font-size: 15px; color: rgba(51,44,40,0.7); margin-bottom: 20px;">No handcrafted pieces matched your search terms.</p>
            <a href="/collections/all" class="btn btn-primary">Browse All Collections</a>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endif -%}

  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search Page",
  "settings": []
}
{% endschema %}
