<section class="handmade-story-section" style="padding: 88px 0; background: var(--color-bg); overflow: hidden;">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16" style="align-items: center;">
      
      <!-- Workshop Image Left -->
      <div class="lg:col-span-6" style="position: relative;">
        <div style="position: relative; aspect-ratio: 4/3; border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-hover); border: 4px solid #FFF;">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1000 }}"
              alt="{{ section.settings.image.alt | default: 'Artisan workshop' | escape }}"
              loading="lazy"
              style="width: 100%; height: 100%; object-fit: cover;"
            >
          {%- else -%}
            <img
              src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1000&q=85"
              alt="Crochet yarn and hands in artisan workshop"
              style="width: 100%; height: 100%; object-fit: cover;"
            >
          {%- endif -%}
        </div>

        <!-- Floating Quote Stamp -->
        <div style="position: absolute; bottom: -20px; right: 20px; background: #FFF; padding: 18px 22px; border-radius: var(--radius-md); box-shadow: var(--shadow-hover); border: 1px solid var(--color-beige); max-width: 280px; z-index: 5;">
          <div style="display: flex; gap: 2px; color: #D9A7A0; margin-bottom: 6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#D9A7A0" stroke="#D9A7A0" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#D9A7A0" stroke="#D9A7A0" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#D9A7A0" stroke="#D9A7A0" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#D9A7A0" stroke="#D9A7A0" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#D9A7A0" stroke="#D9A7A0" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <p style="font-family: var(--font-editorial); font-style: italic; font-size: 13px; color: rgba(51,44,40,0.85); line-height: 1.4;">
            "No two stitches are in a hurry. That is what makes handmade irreplaceable."
          </p>
          <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; color: var(--color-brown); margin-top: 6px; letter-spacing: 0.05em;">
            — Master Knitter, Jaipur
          </div>
        </div>
      </div>

      <!-- Story Right Details -->
      <div class="lg:col-span-6" style="display: flex; flex-direction: column; gap: 18px;">
        <div>
          <span class="badge badge-editorial">
            {{ section.settings.badge | default: 'MADE BY HAND' }}
          </span>
        </div>

        <h2 class="heading-serif" style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15;">
          {{ section.settings.heading | default: 'Every loop tells a story.' }}
        </h2>

        <p style="font-size: 15px; color: rgba(51,44,40,0.8); line-height: 1.6; font-weight: 300;">
          {{ section.settings.text_1 | default: 'Our pieces are carefully crocheted by hand, one stitch at a time. In a world of fleeting fast-fashion, we believe handmade products should feel personal, timeless, and special.' }}
        </p>

        <p style="font-size: 14px; color: rgba(51,44,40,0.75); line-height: 1.6;">
          {{ section.settings.text_2 | default: 'By supporting our collective, you provide sustainable, dignified work for women artisans across Rajasthan, preserving heritage textile crafts for future generations.' }}
        </p>

        <div style="padding-top: 8px;">
          <a href="{{ section.settings.button_link | default: '/pages/about' }}" class="btn btn-primary">
            <span>{{ section.settings.button_text | default: 'OUR STORY' }}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Handmade Story",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "MADE BY HAND"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every loop tells a story."
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Paragraph 1",
      "default": "Our pieces are carefully crocheted by hand, one stitch at a time. In a world of fleeting fast-fashion, we believe handmade products should feel personal, timeless, and special."
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Paragraph 2",
      "default": "By supporting our collective, you provide sustainable, dignified work for women artisans across Rajasthan, preserving heritage textile crafts for future generations."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Artisan Workshop Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Handmade Story"
    }
  ]
}
{% endschema %}
